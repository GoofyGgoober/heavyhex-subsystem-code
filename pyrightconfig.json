{
  // Type checks for everything but runs/. src/ is the code of tag v0.2.0, which every job
  // in runs/ records and which stays byte-identical (tests/test_provenance.py): it is
  // analysed for the code that imports it, but its own 26 reports (third-party stubs:
  // stim's union return types, qiskit's options, GzipFile for BinaryIO) are not shown.
  // docs/analysis/ is treated the same way: its reports are mostly the same stubs (stim's
  // flattened() and its samplers' optional tuples) on research scripts that run as they are.
  "include": ["src", "tests", "scripts", "docs", "paper/figures"],
  "exclude": ["runs", "build", ".venv", "**/__pycache__"],
  "ignore": ["src", "docs/analysis"],
  "extraPaths": ["src", "docs/analysis", "docs/figures"],
  "pythonVersion": "3.10",
  "typeCheckingMode": "basic",
  "reportMissingTypeStubs": false,
  "venvPath": ".",
  "venv": ".venv"
}
